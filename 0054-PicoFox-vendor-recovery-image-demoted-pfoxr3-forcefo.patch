From 14dba3ca05129e872541c838c318e7b51e5d096b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 20:01:59 -0400
Subject: [PATCH] PicoFox vendor recovery image demoted: pfoxr3-forceformat
 reformats the drive at every boot (files written to it vanish at the next
 power cycle, empty CALLSIGN = silent fox); it sits under a 'Recovery image'
 disclosure with a warning, and flashing it tells you to flash pfoxr3v1 before
 writing files

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AwviighMTcaTHg8tykZaoh
---
 boards/picofox-vendor.json | 3 ++-
 docs/picofox-notes.md      | 2 +-
 js/ui/flash.js             | 9 ++++++---
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/boards/picofox-vendor.json b/boards/picofox-vendor.json
index a56a201..a3064c4 100644
--- a/boards/picofox-vendor.json
+++ b/boards/picofox-vendor.json
@@ -18,7 +18,8 @@
       {
         "name": "pfoxr3-forceformat.uf2",
         "url": "https://raw.githubusercontent.com/ai6ym/PicoFox/main/releases/pfoxr3-forceformat.uf2",
-        "note": "same firmware, but it reformats the drive at boot (wipes every file, including fox-bench's); flash pfoxr3v1 afterwards"
+        "recovery": true,
+        "note": "recovery only: reformats the drive at EVERY boot, so files written to it vanish at the next power cycle and the fox stays silent. Use it to wipe a corrupt volume, then flash pfoxr3v1 before writing any files."
       }
     ]
   },
diff --git a/docs/picofox-notes.md b/docs/picofox-notes.md
index 904b9da..948eba0 100644
--- a/docs/picofox-notes.md
+++ b/docs/picofox-notes.md
@@ -34,7 +34,7 @@ that way.
   BOOTSEL (SW2) is inside the enclosure; the Arduino core the vendor
   firmware is built on reboots into the bootloader when the serial port
   is opened at 1200 baud and DTR dropped — the page's "Reboot into
-  bootloader" button. `pfoxr3-forceformat.uf2` reformats the filesystem.
+  bootloader" button. `pfoxr3-forceformat.uf2` reformats the filesystem **at every boot** — files written to it vanish at the next power cycle (and an empty CALLSIGN means silence); flash `pfoxr3v1.uf2` after it before writing anything.
 
 Switching to fox-bench's own firmware and back is a page operation
 (`firmware/foxlib-c/README.md`, "Switching between the two firmwares");
diff --git a/js/ui/flash.js b/js/ui/flash.js
index 2b9a601..55637d8 100644
--- a/js/ui/flash.js
+++ b/js/ui/flash.js
@@ -184,7 +184,8 @@ function uf2Card(app) {
       let gone = false;
       for (let i = 0; i < 12 && !gone; i++) { await new Promise(r => setTimeout(r, 500)); try { for await (const _ of dir.values()) { void _; break; } } catch { gone = true; } }
       const after = uf2.source === 'fox-bench' ? ' The fox\'s drive and a serial port come back; Listen only prints the FOX banner. (The drive keeps the name it was formatted with — PicoFox if the vendor firmware made it — the files on it are what changed.)'
-        : uf2.source === 'vendor' ? ' The fox\'s drive and a serial port come back; Listen only shows "Revision: N … si5351 setup complete" after a power cycle. Select the "(vendor firmware)" target to write its files.' : '';
+        : uf2.source === 'vendor' ? ' The fox\'s drive and a serial port come back; Listen only shows "Revision: N … si5351 setup complete" after a power cycle. Select the "(vendor firmware)" target to write its files.'
+        : uf2.source === 'vendor-recovery' ? ' THIS IMAGE REFORMATS THE DRIVE AT EVERY BOOT: do not write files yet. Flash pfoxr3v1.uf2 next (Reboot into bootloader → Copy), and only then write the four files and power-cycle.' : '';
       uf2.last = gone
         ? { ok: true, text: `${uf2.name} flashed (${(uf2.bytes.length / 1024).toFixed(0)} kB): the ${b.flash.drive_name} drive went away, so the board rebooted into it.${after}` }
         : { ok: false, text: `${uf2.name} was written but the ${b.flash.drive_name} drive is still there after 6 s — the bootloader did not accept it. A .uf2 for another chip, or a copy that did not complete; try again.` };
@@ -199,9 +200,11 @@ function uf2Card(app) {
     h('p.hint', {}, h('b', {}, 'Order: '), 'fox on, plugged in → ', h('b', {}, '1. Reboot into bootloader'), ' (pick the fox\'s serial port) → a drive with just ', h('code', {}, 'INFO_UF2.TXT'), ' and ', h('code', {}, 'INDEX.HTM'), ' appears → ', h('b', {}, '2. Copy'), ' and pick ', h('i', {}, 'that'), ' drive. The page checks for INFO_UF2.TXT, because a .uf2 copied onto the fox\'s own drive is only a file and the board keeps running what it ran.'),
     b.flash.touch_1200 ? h('div.tools', {}, h('button.btn', { disabled: uf2.touching || uf2.busy, onclick: () => touch1200(app) }, uf2.touching ? 'Touching…' : '1. Reboot into bootloader'), h('span.hint', {}, 'Opens the serial port at 1200 baud and closes it: the Arduino way into the bootloader, no button needed.')) : null,
     ours ? h('div.tools', {}, h('button.btn', { disabled: uf2.fetching || uf2.busy, onclick: () => fetchHosted(app) }, uf2.fetching ? 'Fetching…' : 'Get fox-bench firmware'), h('span.hint', {}, `foxbench-picofox.uf2 built from this site\'s source (firmware/foxlib-c/picofox). To go back to the vendor firmware, select the "(vendor firmware)" target: its card fetches the vendor\'s .uf2.`)) : null,
-    !ours && b.firmware?.stock_firmware_files?.length ? h('div', {}, ...b.firmware.stock_firmware_files.map(f => h('div.tools', {}, h('button.btn', { disabled: uf2.fetching || uf2.busy, onclick: () => fetchImage(app, f.url, 'vendor', f.note) }, uf2.fetching ? 'Fetching…' : `Get ${f.name}`), h('span.hint', {}, f.note, ' — fetched from the vendor\'s GitHub into this browser.')))) : null,
+    !ours && b.firmware?.stock_firmware_files?.length ? h('div', {},
+      ...b.firmware.stock_firmware_files.filter(f => !f.recovery).map(f => h('div.tools', {}, h('button.btn', { disabled: uf2.fetching || uf2.busy, onclick: () => fetchImage(app, f.url, 'vendor', f.note) }, uf2.fetching ? 'Fetching…' : `Get ${f.name}`), h('span.hint', {}, f.note, ' — fetched from the vendor\'s GitHub into this browser.'))),
+      ...b.firmware.stock_firmware_files.filter(f => f.recovery).map(f => h('details', { style: 'margin-top:6px' }, h('summary.hint', {}, 'Recovery image (wipes the drive)'), h('div.tools', {}, h('button.btn.small.danger', { disabled: uf2.fetching || uf2.busy, onclick: () => fetchImage(app, f.url, 'vendor-recovery', f.note) }, uf2.fetching ? 'Fetching…' : `Get ${f.name}`), h('span.hint.warn', {}, f.note))))) : null,
     h('div.tools', {}, h('button.btn.small', { onclick: () => fileIn.click() }, 'Load .uf2…'), fileIn, h('span.hint', {}, uf2.name ? `${uf2.name} · ${(uf2.bytes.length / 1024).toFixed(0)} kB${uf2.source === 'fox-bench' ? ' · fox-bench firmware' : ''}` : 'nothing loaded'),
-      h('button.btn' + (uf2.source === 'fox-bench' || uf2.source === 'vendor' ? '.primary' : ''), { disabled: !uf2.bytes || uf2.busy, onclick: copy }, uf2.busy ? 'Copying…' : `2. Copy to ${b.flash.drive_name}…`)),
+      h('button.btn' + (uf2.source === 'fox-bench' || uf2.source === 'vendor' ? '.primary' : uf2.source === 'vendor-recovery' ? '.danger' : ''), { disabled: !uf2.bytes || uf2.busy, onclick: copy }, uf2.busy ? 'Copying…' : `2. Copy to ${b.flash.drive_name}…`)),
     uf2.last ? h('p.hint' + (uf2.last.ok ? '.ok' : '.err'), {}, uf2.last.text) : null,
     ours ? h('p.hint', {}, 'Running fox-bench firmware and Listening? ', h('code', {}, 'bootsel'), ' in the console (or the button on the Board tab) does the same as the touch.') : h('p.hint', {}, 'Want fox-bench\'s own firmware on this board instead (fox.json, the same templates as the CircuitPython foxes, bench over serial)? Pick the "(fox-bench firmware)" entry of this board above.'),
     h('p.hint', {}, 'There is no "flash CircuitPython" here on purpose; the batch-flashing card on the Fleet tab is for the ESP32 family.'));
-- 
