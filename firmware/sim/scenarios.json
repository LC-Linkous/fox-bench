   "fox": {
    "id": {
     "callmessage": "W1ABC FOX DE W1ABC"
    }
   },
   "expect": {
    "banner": {
     "cfg": "ok",
     "radio": "ok",
     "id": "set"
    },
    "keyed_min": 2,
    "id_contains": [
     "W1ABC FOX DE W1ABC"
    ]
   }
  },
