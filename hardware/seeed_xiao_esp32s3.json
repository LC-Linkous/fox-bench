{
  "id": "seeed_xiao_esp32s3",
  "name": "Seeed XIAO ESP32S3",
  "mcu": "ESP32-S3R8",
  "radio": "the SoC's own radios: wifi24, ble",
  "radios": [
    "wifi24",
    "ble"
  ],
  "design": {
    "by": "Seeed Studio",
    "source": "https://wiki.seeedstudio.com/xiao_esp32s3_getting_started/",
    "license": "see the vendor's page"
  },
  "flash": {
    "method": "esptool",
    "chip": "esp32s3",
    "offset": "0x0",
    "flash_mb": 8,
    "bootloader_instructions": "Hold B (BOOT) while plugging in USB-C; release after a second. The chip's USB-JTAG-serial port (303a:1001) appears.",
    "note": "8 MB flash, 8 MB PSRAM; u.FL antenna connector (the supplied antenna must be fitted). Not yet flashed from this page."
  },
  "has_usb_drive": false,
  "usb": [
    {
      "vid": "0x303a",
      "pid": "0x1001",
      "when": "ESP32-S3 USB-JTAG-serial (download mode and, with CDC on boot, the running firmware)"
    }
  ],
  "pins": [
    {
      "name": "LED",
      "gpio": 21,
      "note": "yellow user LED, active low"
    },
    {
      "name": "D0",
      "gpio": 1,
      "aliases": [
        "A0"
      ]
    },
    {
      "name": "D1",
