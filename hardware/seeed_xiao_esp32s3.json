      "aliases": [
        "A1"
      ]
    },
    {
      "name": "D2",
      "gpio": 3,
      "aliases": [
        "A2"
      ]
    },
    {
      "name": "D3",
      "gpio": 4,
      "aliases": [
        "A3"
      ]
    },
    {
      "name": "D4",
      "gpio": 5,
      "aliases": [
        "A4",
        "SDA"
      ]
    },
    {
