  "roles": {
    "led": "LED",
    "batt_sense": null
  },
  "led": {
    "kind": "single",
    "pin": 21,
    "active_low": true,
    "note": "yellow user LED on GPIO21"
  },
  "battery": {
    "charger": true,
    "divider_note": "charger on board (BAT pads); no divider to an ADC pin by default — as the XIAO C3"
  },
  "circuitpython": {
    "board_id": "seeed_xiao_esp32s3",
    "board_ids": [
      "seeed_xiao_esp32s3"
    ],
    "download": "https://circuitpython.org/board/seeed_xiao_esp32s3/",
    "latest_known": "10.3.1",
    "note": "its own build; board.LED is the yellow LED. The Sense variant (camera, mic) reports the same id."
  },
  "notes": [
    "Network fox today (no module). The D-pins are the XIAO footprint's, so a XIAO ESP32S3 + SA868 combination would wire like the XIAO ESP32C3 + SA868 — a future target of its own."
  ]
}
