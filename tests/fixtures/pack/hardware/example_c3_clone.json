{
 "id": "example_c3_clone",
 "log_names": [
  "XIAO ESP32-C3"
 ],
 "name": "Example XIAO C3 clone (pack)",
 "mcu": "ESP32-C3",
 "radio": "external module on the carrier (SA818/SA868 family)",
 "circuitpython": {
  "board_id": "example_c3_clone",
  "download": "https://circuitpython.org/board/seeed_xiao_esp32c3/",
  "latest_known": "10.2.1",
  "note": "an example: a clone with its own CircuitPython build id, so the page can tell it from the XIAO"
 },
 "flash": {
  "method": "esptool",
  "chip": "esp32c3",
  "offset": "0x0",
  "bootloader_instructions": "Unplug. Hold B (BOOT), plug in USB, hold one more second, release. Already plugged in: hold B, tap R, release B.",
  "note": "Values from the XIAO ESP32C3 descriptor; an example of a pack adding a board of the same kind."
 },
 "has_usb_drive": false,
 "usb": [
  {
   "vid": "0x303a",
   "pid": "0x1001",
   "when": "bootloader / USB-JTAG-serial"
  },
  {
   "vid": "0x303a",
   "pid": "0x80d4",
   "when": "CircuitPython CDC (Seeed XIAO ESP32-C3)"
  }
 ],
 "pins": [
  {
   "name": "D0",
   "gpio": 2,
   "adc": true,
   "pwm": true,
   "aliases": [
    "A0"
   ]
  },
  {
   "name": "D1",
   "gpio": 3,
   "adc": true,
   "pwm": true,
   "aliases": [
    "A1"
   ]
  },
  {
   "name": "D2",
   "gpio": 4,
   "adc": true,
   "pwm": true,
   "aliases": [
    "A2"
   ]
  },
  {
   "name": "D3",
   "gpio": 5,
   "adc": true,
   "pwm": true,
   "aliases": [
    "A3"
   ]
  },
  {
   "name": "D4",
   "gpio": 6,
   "pwm": true,
   "aliases": [
    "SDA"
   ]
  },
  {
   "name": "D5",
   "gpio": 7,
   "pwm": true,
   "aliases": [
    "SCL"
   ]
  },
  {
   "name": "D6",
   "gpio": 21,
   "pwm": true,
   "uart_tx": true,
   "aliases": [
    "TX"
   ]
  },
  {
   "name": "D7",
   "gpio": 20,
   "pwm": true,
   "uart_rx": true,
   "aliases": [
    "RX"
   ]
  },
  {
   "name": "D8",
   "gpio": 8,
   "pwm": true,
   "aliases": [
    "SCK"
   ]
  },
  {
   "name": "D9",
   "gpio": 9,
   "pwm": true,
   "aliases": [
    "MISO"
   ],
   "note": "shares the BOOT button; avoid"
  },
  {
   "name": "D10",
   "gpio": 10,
   "pwm": true,
   "aliases": [
    "MOSI"
   ]
  }
 ],
 "roles": {
  "ptt": "D3",
  "pd": "D4",
  "hl": "D5",
  "uart_tx": "D6",
  "uart_rx": "D7",
  "audio": "D1",
  "led": "D10",
  "batt_sense": null
 },
 "battery": {
  "charger": true,
  "divider_note": "BAT+ -> 200k -> ADC -> 200k -> GND. Known layouts use D2/A2 (carrier PCB) or D0/A0 (Seeed wiki). Leave batt_sense null if no divider is fitted."
 },
 "silkscreen": null,
 "radios": [
  "wifi24",
  "ble"
 ],
 "net": {
  "led": null,
  "batt_sense": null,
  "note": "the bare XIAO ESP32C3 has no user LED (only the charge LED); as a network fox it runs dark unless a LED is wired to a pin"
 }
}
